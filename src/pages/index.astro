---
import Layout from '../layouts/Layout.astro';
---

<Layout>
	<div class="site">
		<header class="header">
			<div class="container nav-container">
				<a href="/" class="logo">Home</a>

				<nav>
					<a href="#about">About</a>
					<a href="#experience">Experience</a>
					<a href="/publications">Publications</a>
				</nav>
			</div>
		</header>

		<main>
			<section class="hero container">
				<div class="profile">
					<img
						src="/img/profile.jpg"
						alt="Rommel Jalasutram"
					/>
				</div>

				<div class="hero-content">
					<p class="eyebrow">Software Engineer · ML · Systems</p>

					<h1>Rommel Jalasutram</h1>

					<p class="intro">
						I am a software engineer with interests in{' '}
						<strong>Machine Learning</strong>,{' '}
						<strong>Distributed Systems</strong>, and{' '}
						<strong>Parallel Computing</strong>. Most recently, I worked at Criteo on data engineering
						and machine-learning problems related to Ad Tech.
					</p>
					<p class="email">
						<a href="mailto:r.jalasutram@proton.me">
							r.jalasutram@proton.me
						</a>
					</p>
					<p class="resume-link">
						<a href="/resume.pdf" target="_blank" rel="noopener noreferrer">
						View Resume →
						</a>
					</p>
				</div>
			</section>

			<section id="about" class="section container">
				<div class="section-heading">
					<p class="eyebrow">About</p>
					<h2>Background</h2>
				</div>

				<div class="content-grid">
					<div>
						<p>
							I obtained my PhD in Computer Science at
							<a
								href="https://www.clemson.edu/"
								target="_blank"
								rel="noopener noreferrer"
							>{' '}
							Clemson University
							</a>,
							where I was advised by
							<a
								href="https://people.computing.clemson.edu/~bcdean/"
								target="_blank"
								rel="noopener noreferrer"
							>{' '}
								Prof. Brian C. Dean
							</a>.

							Prior to that, I obtained my Master's in Computer
							Engineering at Clemson University, where I was advised
							by
							<a
								href="https://udayton.edu/directory/engineering/electrical-and-computer/taha_tarek_m.php"
								target="_blank"
								rel="noopener noreferrer"
							>{' '}
								Prof. Tarek M. Taha
							</a>.
							Before coming to Clemson, I spent four years pursuing
							my undergraduate studies at the {' '}
							<strong>National Institute of Technology, Surat</strong>.
						</p>
					</div>

					<div class="interests-card">
						<h3>Interests</h3>
						<ul>
							<li>Machine Learning</li>
							<li>Distributed Systems</li>
							<li>Parallel Computing</li>
							<li>Data Engineering</li>
							<li>Reinforcement Learning</li>
						</ul>
					</div>
				</div>
			</section>

			<section class="section section-muted">
				<div class="container">
					<div class="section-heading">
						<p class="eyebrow">News</p>
						<h2>Currently</h2>
					</div>

					<div class="news-item">
						<span class="news-date">Now</span>
						<p>
							Currently learning and experimenting with {' '}
							<strong>Reinforcement Learning</strong> and GPU Kernels.
						</p>
					</div>
				</div>
			</section>

			<section id="experience" class="section container">
				<div class="section-heading">
					<p class="eyebrow">Experience</p>
					<h2>What I've worked on</h2>
				</div>

				<div class="experience-item">
					<div class="experience-header">
						<h3>Criteo</h3>
						<span>Software Engineering · Data · ML</span>
					</div>

					<p>
						Worked on data engineering and machine-learning problems
						in the Ad Tech domain, with a focus on building and
						scaling data-driven systems.
					</p>
				</div>
			</section>

		</main>

		<footer>
			<div class="container footer-content">
				<span>© {new Date().getFullYear()} Rommel Jalasutram</span>
				<span>Built with Astro</span>
			</div>
		</footer>
	</div>
</Layout>

<style>
	:global(*) {
		box-sizing: border-box;
	}

	:global(html) {
		scroll-behavior: smooth;
	}

	:global(body) {
		margin: 0;
		font-family:
			Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont,
			"Segoe UI", sans-serif;
		color: #1f2937;
		background: #ffffff;
		line-height: 1.7;
	}

	:global(a) {
		color: #2563eb;
		text-decoration: none;
	}

	:global(a:hover) {
		text-decoration: underline;
	}

	.container {
		width: min(1080px, calc(100% - 40px));
		margin: 0 auto;
	}

	.header {
		position: sticky;
		top: 0;
		z-index: 10;
		background: rgba(255, 255, 255, 0.92);
		backdrop-filter: blur(12px);
		border-bottom: 1px solid #e5e7eb;
	}

	.nav-container {
		min-height: 68px;
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 30px;
	}

	.logo {
		font-size: 1.15rem;
		font-weight: 750;
		color: #111827;
	}

	.logo:hover {
		text-decoration: none;
	}

	nav {
		display: flex;
		gap: 24px;
		font-size: 0.92rem;
	}

	nav a {
		color: #4b5563;
	}

	nav a:hover {
		color: #111827;
		text-decoration: none;
	}

	.hero {
		min-height: auto;
		display: grid;
		grid-template-columns: 200px minmax(0, 1fr);
		align-items: center;
		column-gap: 45px;
		padding: 50px 0 25px;
	}

	.eyebrow {
		margin: 0 0 10px;
		color: #2563eb;
		font-size: 0.78rem;
		font-weight: 700;
		letter-spacing: 0.12em;
		text-transform: uppercase;
	}

	h1 {
		margin: 0 0 18px;
		color: #111827;
		font-size: clamp(3rem, 7vw, 5.5rem);
		line-height: 0.98;
		letter-spacing: -0.055em;
	}

	h2 {
		margin: 0;
		color: #111827;
		font-size: clamp(2rem, 4vw, 3rem);
		line-height: 1.1;
		letter-spacing: -0.035em;
	}

	h3 {
		color: #111827;
	}

	.intro {
		max-width: 680px;
		margin: 0 0 8px;
		font-size: 1.2rem;
		color: #374151;
	}

	.intro.secondary {
		color: #6b7280;
		font-size: 1.05rem;
	}

	.profile {
		display: flex;
		justify-content: center;
	}

	.profile img {
		width: 220px;
		height: 230px;
		object-fit: cover;
		border-radius: 24px;
		box-shadow: 0 20px 50px rgba(15, 23, 42, 0.14);
	}

	.links {
		display: flex;
		gap: 12px;
		margin-top: 32px;
	}

	.button {
		display: inline-flex;
		align-items: center;
		padding: 11px 18px;
		border-radius: 9px;
		font-size: 0.92rem;
		font-weight: 650;
	}

	.button:hover {
		text-decoration: none;
	}

	.primary {
		color: white;
		background: #2563eb;
	}

	.primary:hover {
		background: #1d4ed8;
	}

	.secondary-button {
		color: #374151;
		border: 1px solid #d1d5db;
	}

	.secondary-button:hover {
		background: #f9fafb;
	}

	.section {
		padding: 45px 0;
	}

	.section-muted {
		background: #f8fafc;
	}

	.section-heading {
		margin-bottom: 30px;
	}

	.content-grid {
		display: grid;
		grid-template-columns: 1fr 300px;
		gap: 45px;
		font-size: 1.05rem;
	}

	.interests-card {
		padding: 28px;
		border: 1px solid #e5e7eb;
		border-radius: 16px;
		background: white;
	}

	.interests-card h3 {
		margin-top: 0;
	}

	.interests-card ul {
		margin: 0;
		padding-left: 20px;
	}

	.news-item {
		display: flex;
		gap: 30px;
		align-items: baseline;
		padding: 20px 0;
		border-top: 1px solid #e5e7eb;
		border-bottom: 1px solid #e5e7eb;
	}

	.news-date {
		min-width: 45px;
		color: #6b7280;
		font-size: 0.85rem;
		font-weight: 650;
	}

	.experience-item {
		max-width: 800px;
		padding-left: 25px;
		border-left: 3px solid #2563eb;
	}

	.experience-header {
		display: flex;
		align-items: baseline;
		justify-content: space-between;
		gap: 20px;
	}

	.experience-header h3 {
		margin: 0;
		font-size: 1.4rem;
	}

	.experience-header span {
		color: #6b7280;
		font-size: 0.9rem;
	}

	.publication-list {
		max-width: 850px;
	}

	.publication-list > h3 {
		margin-bottom: 25px;
	}

	.publication {
		padding: 16px 0;
		border-top: 1px solid #e5e7eb;
	}

	.publication h4 {
		margin: 0 0 8px;
		color: #111827;
		font-size: 1.05rem;
		line-height: 1.5;
	}

	.authors {
		margin: 0 0 10px;
		color: #6b7280;
	}

	.subheading {
		margin-top: 55px;
	}

	.contact {
		padding-bottom: 70px;
	}

	.email {
		margin-top: 18px;
		margin-bottom: 4px;
		font-size: 1rem;
		font-weight: 600;
	}

	.resume-link {
		margin: 0;
		font-size: 0.95rem;
	}

	.resume-link a {
		color: #2563eb;
	}

	footer {
		padding: 30px 0;
		border-top: 1px solid #e5e7eb;
		color: #6b7280;
		font-size: 0.85rem;
	}

	.footer-content {
		display: flex;
		justify-content: space-between;
		gap: 20px;
	}

	@media (max-width: 760px) {
		.nav-container {
			align-items: flex-start;
			padding: 16px 0;
			flex-direction: column;
		}

		nav {
			width: 100%;
			overflow-x: auto;
			padding-bottom: 4px;
		}

		.hero {
			grid-template-columns: 1fr;
			gap: 25px;
			padding-top: 40px;
			padding-bottom: 45px;
		}

		.profile {
			order: -1;
			justify-content: flex-start;
		}

		.profile img {
			width: 170px;
			height: 195px;
		}

		.content-grid {
			grid-template-columns: 1fr;
			gap: 35px;
		}

		.experience-header {
			flex-direction: column;
			gap: 4px;
		}

		.footer-content {
			flex-direction: column;
		}
	}
</style>
